{
  "$schema": "https://yakbd.github.io/kbl-spec/schema/0.3/kbl.schema.json",
  "kbl": "0.3",
  "metadata": {
    "id": "da-t-k0-kbltouch",
    "name": "Danish touch (example)",
    "version": "0.2.1",
    "license": "MIT-0",
    "description": "Example (i): an on-screen keyboard for both touch targets: a phone set whose bottom row the target adds (systemRow, targets.*.systemRow) and a tablet set with its own bottom row and taller last row, a dead key usable on touch and on a physical keyboard, long-press lists with hints, one-shot shift with caps lock on a double tap, hardware layers for Android's physical-key mode, and targets.androidime and targets.ios pins (package name, bundle ids, return-key labels).",
    "authors": [
      {
        "name": "The YAKBD contributors"
      }
    ]
  },
  "positions": {
    "KeyA": {
      "scanCode": "1E"
    },
    "KeyE": {
      "scanCode": "12"
    },
    "Semicolon": {
      "scanCode": "27"
    },
    "Quote": {
      "scanCode": "28"
    },
    "BracketLeft": {
      "scanCode": "1A"
    },
    "Equal": {
      "scanCode": "0D"
    }
  },
  "keys": {
    "shift": {
      "function": "shift",
      "layerId": "shift",
      "multiTapKeyIds": [
        "capsLock"
      ],
      "width": 1.5
    },
    "capsLock": {
      "function": "capsLock",
      "layerId": "caps"
    },
    "unshift": {
      "function": "shift",
      "layerId": "base",
      "width": 1.5
    },
    "bksp": {
      "function": "backspace",
      "width": 1.5
    },
    "acute": {
      "deadKey": "acute"
    },
    "a": {
      "output": "a",
      "longPressKeyIds": [
        "aRing",
        "aeLig"
      ],
      "longPressDefaultKeyId": "aRing",
      "hint": "å"
    },
    "aRing": {
      "output": "å"
    },
    "aeLig": {
      "output": "æ"
    },
    "A": {
      "output": "A",
      "longPressKeyIds": [
        "ARing"
      ]
    },
    "ARing": {
      "output": "Å"
    },
    "oSlash": {
      "output": "ø"
    },
    "OSlash": {
      "output": "Ø"
    },
    "toSymbols": {
      "layerId": "symbols",
      "width": 1.5
    },
    "toLetters": {
      "layerId": "base",
      "width": 1.5
    },
    "enter": {
      "function": "enter",
      "width": 2
    },
    "globe": {
      "function": "nextKeyboard"
    }
  },
  "deadKeys": {
    "acute": {
      "spacing": "´",
      "entries": [
        {
          "base": "a",
          "result": "á"
        },
        {
          "base": "e",
          "result": "é"
        },
        {
          "base": "A",
          "result": "Á"
        },
        {
          "base": "E",
          "result": "É"
        },
        {
          "base": " ",
          "result": "´"
        }
      ]
    }
  },
